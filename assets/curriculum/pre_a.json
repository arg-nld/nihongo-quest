 "grammar": [
  {
   "id": "pre_a_g_systems",
   "title": "The three writing systems",
   "pattern": "hiragana + katakana + kanji (+ roomaji)",
   "explanation": "Hiragana and katakana are phonetic characters - each represents a sound. Kanji are Chinese characters with meaning. Hiragana and kanji together form most Japanese words; katakana is mostly for words of foreign origin. Roman letters (roomaji) are used in media too.",
   "examples": [
    {
     "japanese": "ひらがな",
     "romaji": "hiragana",
     "english": "phonetic script for Japanese words"
    },
    {
     "japanese": "カタカナ",
     "romaji": "katakana",
     "english": "phonetic script for foreign words"
    }
   ],
   "mistakes": [
    "Reading romaji TO as English 'too' - in Japanese it is 'toh'"
   ],
   "source": "pre_a p.13"
  },
  {
   "id": "pre_a_g_vowels",
   "title": "The five vowels",
   "pattern": "a = 'ah' (father), i = 'ee' (see), u = 'oo' (zoo), e = 'eh' (men), o = 'oh' (boat)",
   "explanation": "Japanese has only about a hundred sounds, all built on these five short vowels. Keep them short and simple with no glide.",
   "examples": [
    {
     "japanese": "あかい",
     "romaji": "akai",
     "english": "red - a as in father"
    },
    {
     "japanese": "いのち",
     "romaji": "inochi",
     "english": "life - i as in see"
    }
   ],
   "mistakes": [
    "Gliding vowels like English 'o' in 'boat' - Japanese o is a pure 'oh'"
   ],
   "source": "pre_a p.14"
  },
  {
   "id": "pre_a_g_long",
   "title": "Long vowels change meaning",
   "pattern": "ie (house) vs iie (no); obasan (aunt) vs obaasan (grandmother)",
   "explanation": "Lengthening one syllable can change a word's meaning. This book writes long vowels by repeating the vowel (aa, ii, uu, ei/ee, ou), matching how hiragana actually writes them.",
   "examples": [
    {
     "japanese": "いえ",
     "romaji": "ie",
     "english": "house"
    },
    {
     "japanese": "いいえ",
     "romaji": "iie",
     "english": "no"
    }
   ],
   "mistakes": [
    "Saying obasan (aunt) when you mean obaasan (grandmother)"
   ],
   "source": "pre_a p.15"
  },
  {
   "id": "pre_a_g_double",
   "title": "Double consonants are stressed",
   "pattern": "roku (six) vs rokku (rock); mata (again) vs matta (waited)",
   "explanation": "Double consonants like kk, pp, tt and cch must be stressed (a tiny pause before the sound) or the meaning changes.",
   "examples": [
    {
     "japanese": "ろく",
     "romaji": "roku",
     "english": "six"
    },
    {
     "japanese": "ロック",
     "romaji": "rokku",
     "english": "rock (music)"
    }
   ],
   "mistakes": [
    "Saying mata (again) instead of matta (waited)"
   ],
   "source": "pre_a p.16"
  }
 ],
