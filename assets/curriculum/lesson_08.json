 "grammar": [
  {
   "id": "lesson_08_g_deshita",
   "title": "Making sentences in the past tense with deshita",
   "pattern": "[sentence] + deshita / [sentence] + deshita ka",
   "explanation": "Deshita is the past tense of desu. It is used exactly like desu except that it makes the sentence past tense: desu means 'is, am, are', while deshita means 'was, were'. Add ka to ask a question about the past.",
   "examples": [
    {
     "japanese": "きのうは ついたち でしたか。",
     "romaji": "Kinou wa tsuitachi deshita ka.",
     "english": "Was yesterday the 1st?"
    },
    {
     "japanese": "わたし でしたか。あなた でした。",
     "romaji": "Watashi deshita ka. Anata deshita.",
     "english": "Was it me? It was you."
    },
    {
     "japanese": "くるまは あか でしたか。あかの くるま でした。",
     "romaji": "Kuruma wa aka deshita ka. Aka no kuruma deshita.",
     "english": "Was the car red? It was a red car."
    }
   ],
   "mistakes": [
    "Using desu for something that already happened — switch to deshita"
   ],
   "source": "lesson_08 p.168"
  },
  {
   "id": "lesson_08_g_dates",
   "title": "Saying dates with month and day of the month",
   "pattern": "MONTH + DAY OF MONTH",
   "explanation": "When saying full dates — for example 'December 10th' or 'the 20th of January' — you must always say the month first and then the day of the month.",
   "examples": [
    {
     "japanese": "いちがつ いつか",
     "romaji": "ichigatsu itsuka",
     "english": "January 5th"
    },
    {
     "japanese": "ごがつ ここのか",
     "romaji": "gogatsu kokonoka",
     "english": "May 9th"
    },
    {
     "japanese": "じゅうにがつ にじゅうににち",
     "romaji": "juunigatsu nijuuninichi",
     "english": "the 22nd of December"
    }
   ],
   "mistakes": [
    "Saying the day of the month before the month"
   ],
   "source": "lesson_08 p.168"
  },
  {
   "id": "lesson_08_g_questionwords",
   "title": "Three new question words: itsu, nannichi, nangatsu",
   "pattern": "itsu = when? / nannichi = what day of the month? / nangatsu = what month?",
   "explanation": "This lesson adds three question words, and the teachers warn that many people get them mixed up, so concentrate on them. Itsu asks 'when?' in general; nannichi asks for the day of the month; nangatsu asks for the month.",
   "examples": [
    {
     "japanese": "いつですか。",
     "romaji": "Itsu desu ka.",
     "english": "When is it?"
    },
    {
     "japanese": "なんにち ですか。",
     "romaji": "Nannichi desu ka.",
     "english": "What day of the month is it?"
    },
    {
     "japanese": "なんがつ ですか。",
     "romaji": "Nangatsu desu ka.",
     "english": "What month is it?"
    }
   ],
   "mistakes": [
    "Using nannichi when you mean to ask 'when?' in general — that question word is itsu"
   ],
   "source": "lesson_08 p.164, 169"
  },
  {
   "id": "lesson_08_g_daysofmonth",
   "title": "Days of the month: the tricky ones",
   "pattern": "1st tsuitachi ... 10th tooka; 14th juuyokka; 20th hatsuka; 24th nijuuyokka",
   "explanation": "The first ten days of the month have no internal pattern, so just memorize them — they are important because they set the pattern for other areas of counting. The 14th, 20th and 24th are highlighted in the book because they do not follow the pattern you might expect. Also watch yokka (4th) vs youka (8th): the 'yo' in yokka is short, while youka has an u after it that doubles the length — remember that 8 is double 4.",
   "examples": [
    {
     "japanese": "ついたち",
     "romaji": "tsuitachi",
     "english": "the 1st"
    },
