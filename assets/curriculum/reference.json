 "grammar": [
  {
   "id": "reference_g_phrasebook_guide",
   "title": "Everyday phrasebook",
   "pattern": "greetings · introductions · communication",
   "explanation": "The back matter organizes useful fixed expressions into categories. Phrase translations are context-dependent; learn when a phrase is used as well as its literal meaning.",
   "examples": [
    {
     "japanese": "はじめまして",
     "romaji": "hajimemashite",
     "english": "Nice to meet you."
    },
    {
     "japanese": "よろしくおねがいします",
     "romaji": "yoroshiku onegai shimasu",
     "english": "A set phrase used when meeting or making a request."
    }
   ],
   "source": "reference p.270-271"
  },
  {
   "id": "reference_g_communication",
   "title": "When you need help understanding",
   "pattern": "[language] で なんですか",
   "explanation": "Use the language name with で to ask how something is said. The phrase list also includes asking a speaker to repeat or slow down.",
   "examples": [
    {
     "japanese": "にほんごでなんですか",
     "romaji": "Nihongo de nan desu ka",
     "english": "What is it in Japanese?"
    },
    {
     "japanese": "もういちどいってください",
     "romaji": "Mou ichido itte kudasai",
     "english": "Please say it once again."
    }
   ],
   "source": "reference p.271"
  },
  {
   "id": "reference_g_food",
   "title": "At a restaurant",
   "pattern": "[item] をください",
   "explanation": "These reference phrases are practical templates for ordering food and drinks. Replace the item with the thing you want.",
   "examples": [
    {
     "japanese": "メニューをください",
     "romaji": "Menyuu o kudasai",
     "english": "A menu, please."
    },
    {
     "japanese": "みずをください",
     "romaji": "Mizu o kudasai",
     "english": "Water, please."
    },
    {
     "japanese": "ごちそうさまでした",
     "romaji": "Gochisou sama deshita",
     "english": "Said after a meal."
    }
   ],
   "source": "reference p.272"
  },
  {
   "id": "reference_g_home",
   "title": "Entering and leaving home",
   "pattern": "ittekimasu / tadaima",
   "explanation": "The phrase list marks these as conventional expressions used when leaving home, responding to someone leaving, returning, and entering or leaving another person's home.",
   "examples": [
    {
     "japanese": "いってきます",
     "romaji": "Ittekimasu",
     "english": "I am going and will come back."
    },
    {
     "japanese": "いってらっしゃい",
     "romaji": "Itterasshai",
     "english": "Go and be careful."
    },
    {
     "japanese": "ただいま",
     "romaji": "Tadaima",
     "english": "I am home."
    },
    {
     "japanese": "おかえりなさい",
     "romaji": "Okaerinasai",
     "english": "Welcome home."
    }
   ],
   "source": "reference p.272-273"
  },
  {
   "id": "reference_g_requests",
   "title": "Requests with ください",
   "pattern": "[verb] てください",
   "explanation": "The command/request page groups common requests such as asking someone to show, guide, eat, read, say, write, look, come, or stop. These short templates are listed for reference, not assessment.",
   "examples": [
    {
     "japanese": "みてください",
     "romaji": "Mite kudasai",
     "english": "Please look."
    },
    {
     "japanese": "かいてください",
     "romaji": "Kaite kudasai",
     "english": "Please write it."
    }
   ],
   "source": "reference p.273"
  },
  {
   "id": "reference_g_surnames",
   "title": "Japanese surnames",
   "pattern": "surname + possible kanji meaning",
   "explanation": "The surname list provides example readings and possible meanings based on kanji. A surname can have multiple kanji spellings, so these meanings should be treated as the examples listed in the book, not universal definitions.",
   "examples": [
    {
     "japanese": "たなか",
     "romaji": "Tanaka",
     "english": "The book lists 田中 and the possible meaning ‘inner rice paddy’."
    },
    {
     "japanese": "すずき",
     "romaji": "Suzuki",
     "english": "The book lists 鈴木 and the possible meaning ‘bell tree’."
    }
   ],
   "source": "reference p.274-275"
  },
  {
   "id": "reference_g_given_names",
   "title": "Given names",
   "pattern": "reading + possible kanji spellings",
   "explanation": "The book lists common girls' and boys' given names with examples of possible kanji. A single reading may have many possible kanji spellings; the reference list is illustrative rather than exhaustive.",
   "examples": [
    {
     "japanese": "あい",
     "romaji": "Ai",
     "english": "Example given name; one listed kanji is 愛."
    },
    {
     "japanese": "はるか",
     "romaji": "Haruka",
     "english": "A listed girls' given name."
    }
   ],
   "source": "reference p.276-281"
  },
  {
   "id": "reference_g_glossaries",
   "title": "Three glossary views",
   "pattern": "English ↔ romaji ↔ kana",
   "explanation": "The book's reference pages include an English glossary, a romaji glossary, and a kana glossary. This in-app list is a curated starter set with page provenance, not a transcription of every glossary entry.",
   "examples": [
    {
     "japanese": "いま",
     "romaji": "ima",
     "english": "now"
