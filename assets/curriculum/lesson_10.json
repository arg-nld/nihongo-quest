 "grammar": [
  {
   "id": "lesson_10_g_kudasai",
   "title": "Request an item: ください",
   "pattern": "[item] を ください",
   "explanation": "Use を to mark the thing being requested. ください is used within a request sentence rather than by itself.",
   "examples": [
    {
     "japanese": "みずを ください。",
     "romaji": "Mizu o kudasai.",
     "english": "Water, please."
    },
    {
     "japanese": "りんごを ください。",
     "romaji": "Ringo o kudasai.",
     "english": "An apple, please."
    }
   ],
   "mistakes": [
    "Do not omit を in the standard [item] をください pattern."
   ],
   "source": "lesson_10 p.199-200"
  },
  {
   "id": "lesson_10_g_onegaishimasu",
   "title": "A more formal request",
   "pattern": "[item] を おねがいします",
   "explanation": "おねがいします is another polite way to request an item. It is especially useful when you want to sound more formal; it can also be used alone to say ‘please’.",
   "examples": [
    {
     "japanese": "みずを おねがいします。",
     "romaji": "Mizu o onegai shimasu.",
     "english": "Would you please give me water?"
    },
    {
     "japanese": "メニューを おねがいします。",
     "romaji": "Menyuu o onegai shimasu.",
     "english": "A menu, please."
    }
   ],
   "mistakes": [
    "ください and おねがいします are both polite; choose おねがいします for a more formal request."
   ],
   "source": "lesson_10 p.200"
  },
  {
   "id": "lesson_10_g_mo",
   "title": "The particle も — too / also",
   "pattern": "[word] も ...",
   "explanation": "も follows the word it refers to and means ‘too’ or ‘also’. When it takes the topic's place, it replaces は or が rather than being added after them.",
   "examples": [
    {
     "japanese": "りんごも すきです。",
     "romaji": "Ringo mo suki desu.",
     "english": "I like apples too."
    },
    {
     "japanese": "おちゃも ください。",
     "romaji": "Ocha mo kudasai.",
     "english": "Tea too, please."
    }
   ],
   "mistakes": [
    "When も replaces the topic particle, do not write はも or がも."
   ],
   "source": "lesson_10 p.200-201"
  },
  {
   "id": "lesson_10_g_size",
   "title": "Sizes as の adjectives",
   "pattern": "[size] の [item]",
   "explanation": "The size words エス (S), エム (M), and エル (L) attach to a noun with の. This is the pattern used for items such as small cola or large pizza.",
   "examples": [
    {
     "japanese": "エルの ピザが ほしいです。",
     "romaji": "Eru no piza ga hoshii desu.",
     "english": "I want a large pizza."
    }
   ],
   "mistakes": [
    "Do not directly join the size word and the food noun without の."
   ],
   "source": "lesson_10 p.201-202"
  },
  {
   "id": "lesson_10_g_compound_kana",
   "title": "Compound hiragana",
   "pattern": "full kana + small や / ゆ / よ",
   "explanation": "Compound hiragana combine a kana from the i-row with a smaller や, ゆ, or よ. The second kana is visibly smaller, changing the combined sound, as in きゃ (kya), しゅ (shu), and ちょ (cho).",
   "examples": [
    {
     "japanese": "きゃ",
     "romaji": "kya",
     "english": "compound sound kya"
    },
    {
     "japanese": "しゅ",
     "romaji": "shu",
     "english": "compound sound shu"
    },
    {
     "japanese": "ちょ",
     "romaji": "cho",
     "english": "compound sound cho"
    }
   ],
   "mistakes": [
    "The second character must be small; きや is not the same as きゃ."
   ],
   "source": "lesson_10 p.205-209"
  }
 ],
